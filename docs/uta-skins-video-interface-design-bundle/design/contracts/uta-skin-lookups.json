{
  "contractVersion": 1,
  "principle": "All runtime lookups remain inside lazer ISkin/SkinTransformer. Null means omitted and triggers fallback; Drawable.Empty means intentionally disabled for optional components.",
  "precedence": [
    "skin-provided Uta drawable component lookup",
    "Uta legacy texture adapter over the selected .osk skin",
    "built-in uta! Prism fallback drawable"
  ],
  "lookupTypes": {
    "UtaSkinComponentLookup": [
      "PitchGuide",
      "Lyrics",
      "ScoreHud",
      "PracticeHud",
      "JudgementFeedbackLayer",
      "SingingParticleLayer",
      "ScoringParticleLayer"
    ],
    "UtaTargetNoteLookup": [
      "note kind",
      "visual state"
    ],
    "UtaCurveLookup": [
      "Reference",
      "Live",
      "Trail"
    ],
    "UtaGridLookup": [
      "Major",
      "Minor"
    ],
    "UtaScoringFeedbackLookup": [
      "grade",
      "fault flags"
    ],
    "UtaSkinColour": [
      "canvas",
      "surface",
      "surfaceRaised",
      "surfaceSoft",
      "border",
      "text",
      "muted",
      "subtle",
      "target",
      "targetGolden",
      "targetFreestyle",
      "targetRap",
      "targetSpoken",
      "reference",
      "liveNeutral",
      "liveAccurate",
      "liveNear",
      "liveOff",
      "perfect",
      "great",
      "good",
      "bad",
      "miss",
      "focus",
      "info",
      "warning",
      "danger"
    ],
    "UtaSkinMetric": [
      "pitchGuideHeight",
      "pitchGuideTopMargin",
      "pitchGuideHorizontalMargin",
      "playheadFraction",
      "gridMajorWeight",
      "gridMinorWeight",
      "referenceCurveWeight",
      "liveCurveWeight",
      "guideTrailWeight",
      "guideTrailGlow",
      "targetNoteHeight",
      "targetNoteBorder",
      "targetNoteCornerRadius",
      "targetNoteMinimumWidth",
      "targetNoteGap",
      "lyricCurrentSize",
      "lyricReadingSize",
      "lyricUpcomingSize",
      "hudCornerRadius",
      "hudPadding",
      "touchTargetMinimum",
      "focusRing"
    ],
    "UtaSkinMotion": [
      "animationIntensity",
      "notePulseMs",
      "judgementPopMs",
      "panelTransitionMs",
      "particleLifetimeMs",
      "maxSingingParticles",
      "maxScoringParticles",
      "reducedMotion"
    ]
  },
  "criticalPolicy": {
    "critical": [
      "target notes",
      "live pitch curve",
      "playhead",
      "current lyric text",
      "scoring fault text"
    ],
    "behaviour": "Critical cues cannot become invisible. A minimum-contrast outline/pattern overlay is retained even when a skin returns an empty or low-contrast asset.",
    "optional": [
      "grid",
      "guide trail",
      "particles",
      "decorative panel texture"
    ]
  },
