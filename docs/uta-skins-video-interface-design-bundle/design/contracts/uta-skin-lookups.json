  "fallbackExamples": {
    "targetNote": [
      "uta-target-note-{kind}-{state}",
      "uta-target-note-{kind}",
      "uta-target-note-normal",
      "built-in vector target note"
    ],
    "feedback": [
      "skin drawable UtaScoringFeedbackLookup",
      "uta-feedback-{grade}",
      "built-in icon + localised text"
    ],
    "font": [
      "skin-selected bundled font alias",
      "Torus",
      "framework glyph fallback"
    ]
  },
  "performanceRules": [
    "Never call GetTexture/GetConfig inside per-frame curve sampling loops.",
    "Resolve skin values once into immutable UtaVisualStyle and rebuild on skin reload.",
    "Pool particles and feedback drawables; cap counts in both normal and reduced-motion modes.",
    "Continuous curves remain ruleset-owned Path drawables; skins customise brush texture, colour, weight and dash pattern rather than spawning one Drawable per segment."
  ]
}
