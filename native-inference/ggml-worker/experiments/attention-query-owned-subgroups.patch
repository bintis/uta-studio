diff --git a/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1_query_owned.comp b/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1_query_owned.comp
new file mode 100644
index 0000000..90561ed
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1_query_owned.comp
@@ -0,0 +1,245 @@
+#version 450
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+#extension GL_KHR_memory_scope_semantics : require
+#extension GL_KHR_cooperative_matrix : require
+
+#include "types.glsl"
+#include "flash_attn_base.glsl"
+
+// H64, F16 K/V, F32 accumulation, native SIMD32 only. Each subgroup owns
+// eight queries for the complete key traversal. There is no cross-subgroup
+// score or output exchange, and no assumed mapping of matrix elements to lanes.
+layout(binding = 0) readonly buffer Query { float query_data[]; };
+layout(binding = 1) readonly buffer Key { float16_t key_data[]; };
+layout(binding = 1) readonly buffer KeyVectors { f16vec4 key_vectors[]; };
+layout(binding = 2) readonly buffer Value { float16_t value_data[]; };
+layout(binding = 2) readonly buffer ValueVectors { f16vec4 value_vectors[]; };
+layout(binding = 3) readonly buffer Mask { float16_t mask_data[]; };
+
+// Per subgroup: separate 1024-byte query and tail workspaces, 2048-byte
+// score/output workspace and 512-byte probabilities. Subgroup barriers protect
+// each reuse; the query tile stays read-only throughout the key traversal.
+shared f16vec4 operand_workspace[row_split * 128];
+shared vec4 float_workspace[row_split * 128];
+shared f16vec4 probability_workspace[row_split * 64];
+shared f16vec4 query_workspace[row_split * 128];
+
+void main() {
+    init_indices();
+    const uint lane = gl_SubgroupInvocationID;
+    const uint group = gl_SubgroupID;
+    const uint local_row = lane / 4;
+    const uint row_lane = lane % 4;
+    const uint first_query = i * Br + group * 8;
+    if (first_query >= N) {
+        return; // subgroup-uniform; no workgroup barriers in this shader
+    }
+    const uint operand_base = group * 128;
+    const uint float_base = group * 128;
+    const uint probability_base = group * 64;
+    const uint query_base = (iq2 * p.nb02 + iq3 * p.nb03) / 4;
+    const uint key_base = (ik2 * p.nb12 + ik3 * p.nb13) / 2;
+    const uint value_base = (iv2 * p.nb22 + iv3 * p.nb23) / 2;
+    uint mask_base = 0;
+    if (p.nem2 != 1 || p.nem3 != 1) {
+        mask_base = ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
+    }
+    const float negative = uintBitsToFloat(0xFEFFFFFF);
+    const float head_slope = p.max_bias > 0.0
+        ? float(perElemOpComputeSlope(0, 0, ACC_TYPE(0), iq2)) : 1.0;
+
+    [[unroll]] for (uint index = lane; index < 128; index += 32) {
+        const uint row = index / 16;
+        const uint depth = (index % 16) * 4;
+        vec4 query = vec4(0);
+        if (first_query + row < N) {
+            const uint address = query_base + (first_query + row) * q_stride + depth;
+            query = vec4(query_data[address], query_data[address + 1],
+                         query_data[address + 2], query_data[address + 3]);
+        }
+        query_workspace[operand_base + index] = f16vec4(query * p.scale);
+    }
+    subgroupBarrier();
+
+    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> output_tiles[4];
+    [[unroll]] for (uint depth_tile = 0; depth_tile < 4; ++depth_tile) {
+        output_tiles[depth_tile] = coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0);
+    }
+    float running_maximum = negative;
+    float normalizer = 0.0;
+
+    [[dont_unroll]] for (uint block = start_j; block < end_j; ++block) {
+        // Q * K^T: the M=8 axis is query-owned, rather than key-owned.
+        [[unroll]] for (uint key_tile = 0; key_tile < 2; ++key_tile) {
+            coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> scores =
+                coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0);
+            const uint key_row = block * 32 + key_tile * 16;
+            [[unroll]] for (uint depth_tile = 0; depth_tile < 4; ++depth_tile) {
+                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> keys;
+                if (key_row + 16 <= KV && (k_stride & 7) == 0) {
+                    coopMatLoad(keys, key_vectors, key_base / 4 + key_row * k_stride / 4 + depth_tile * 4,
+                                k_stride / 4, gl_CooperativeMatrixLayoutColumnMajor);
+                } else {
+                    [[unroll]] for (uint index = lane; index < 64; index += 32) {
+                        const uint row = key_row + index / 4;
+                        const uint depth = depth_tile * 16 + (index % 4) * 4;
+                        f16vec4 value = f16vec4(0);
+                        if (row < KV) {
+                            const uint address = key_base + row * k_stride + depth;
+                            value = f16vec4(key_data[address], key_data[address + 1],
+                                            key_data[address + 2], key_data[address + 3]);
+                        }
+                        operand_workspace[operand_base + index] = value;
+                    }
+                    subgroupBarrier();
+                    coopMatLoad(keys, operand_workspace, operand_base, 4, gl_CooperativeMatrixLayoutColumnMajor);
+                }
+                coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> query;
+                coopMatLoad(query, query_workspace, operand_base + depth_tile * 4,
+                            16, gl_CooperativeMatrixLayoutRowMajor);
+                scores = coopMatMulAdd(query, keys, scores);
+                // Protect the local operand tile before another contraction overwrites it.
+                if (key_row + 16 > KV || (k_stride & 7) != 0) {
+                    subgroupBarrier();
+                }
+            }
+            coopMatStore(scores, float_workspace, float_base + key_tile * 4,
+                         8, gl_CooperativeMatrixLayoutRowMajor);
+        }
+        subgroupBarrier();
+
+        // Four adjacent lanes own one query row, eight keys per lane. Online
+        // max/sum state is scalar instead of replicating eight rows in each lane.
+        vec4 packed_scores[2];
+        float row_maximum = negative;
+        [[unroll]] for (uint part = 0; part < 2; ++part) {
+            vec4 scores = float_workspace[float_base + local_row * 8 + row_lane * 2 + part];
+            if (LOGIT_SOFTCAP) {
+                scores = p.logit_softcap * tanh(scores);
+            }
+            [[unroll]] for (uint component = 0; component < 4; ++component) {
+                const uint key_column = block * 32 + row_lane * 8 + part * 4 + component;
+                const uint query_row = first_query + local_row;
+                if (key_column >= KV) {
+                    scores[component] = negative;
+                } else if (MASK_ENABLE && query_row < N && query_row < p.nem1) {
+                    scores[component] += head_slope * float(mask_data[mask_base + query_row * m_stride + key_column]);
+                }
+            }
+            packed_scores[part] = scores;
+            row_maximum = max(row_maximum, max(max(scores.x, scores.y), max(scores.z, scores.w)));
+        }
+        row_maximum = max(row_maximum, subgroupShuffleXor(row_maximum, 1));
+        row_maximum = max(row_maximum, subgroupShuffleXor(row_maximum, 2));
+        const float maximum = max(running_maximum, row_maximum + FATTN_KQ_MAX_OFFSET);
+        const float rescale = exp(running_maximum - maximum);
+        running_maximum = maximum;
+        normalizer *= rescale;
+        [[unroll]] for (uint part = 0; part < 2; ++part) {
+            f16vec4 probabilities = f16vec4(exp(packed_scores[part] - vec4(maximum)));
+            [[unroll]] for (uint component = 0; component < 4; ++component) {
+                const uint key_column = block * 32 + row_lane * 8 + part * 4 + component;
+                if (key_column >= KV) {
+                    probabilities[component] = float16_t(0);
+                }
+                normalizer += float(probabilities[component]);
+            }
+            probability_workspace[probability_base + local_row * 8 + row_lane * 2 + part] = probabilities;
+        }
+        subgroupBarrier();
+        // Row-major 8x16 broadcast matrix: no fragment-to-lane assumption.
+        float_workspace[float_base + lane] = vec4(rescale);
+        subgroupBarrier();
+        coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> rescale_matrix;
+        coopMatLoad(rescale_matrix, float_workspace, float_base, 4, gl_CooperativeMatrixLayoutRowMajor);
+        [[unroll]] for (uint depth_tile = 0; depth_tile < 4; ++depth_tile) {
+            output_tiles[depth_tile] = output_tiles[depth_tile] * rescale_matrix;
+        }
+
+        // Keep each block's product separate, preserving the previous algorithm's
+        // blockwise addition instead of silently extending its FMA accumulation chain.
+        [[unroll]] for (uint depth_tile = 0; depth_tile < 4; ++depth_tile) {
+            // Only one temporary product survives at a time. Holding four here
+            // alongside Q and O spilled the first prototype beyond 128 GRFs.
+            coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> product =
+                coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0);
+            [[unroll]] for (uint key_tile = 0; key_tile < 2; ++key_tile) {
+                coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> probabilities;
+                coopMatLoad(probabilities, probability_workspace, probability_base + key_tile * 4,
+                            8, gl_CooperativeMatrixLayoutRowMajor);
+                const uint value_row = block * 32 + key_tile * 16;
+                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> values;
+                if (value_row + 16 <= KV && (v_stride & 7) == 0) {
+                    coopMatLoad(values, value_vectors, value_base / 4 + value_row * v_stride / 4 + depth_tile * 4,
+                                v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
+                } else {
+                    [[unroll]] for (uint index = lane; index < 64; index += 32) {
+                        const uint row = value_row + index / 4;
+                        const uint depth = depth_tile * 16 + (index % 4) * 4;
+                        f16vec4 value = f16vec4(0);
+                        if (row < KV) {
+                            const uint address = value_base + row * v_stride + depth;
+                            value = f16vec4(value_data[address], value_data[address + 1],
+                                            value_data[address + 2], value_data[address + 3]);
+                        }
+                        operand_workspace[operand_base + index] = value;
+                    }
+                    subgroupBarrier();
+                    coopMatLoad(values, operand_workspace, operand_base, 4, gl_CooperativeMatrixLayoutRowMajor);
+                }
+                product = coopMatMulAdd(probabilities, values, product);
+                if (value_row + 16 > KV || (v_stride & 7) != 0) {
+                    subgroupBarrier();
+                }
+            }
+            output_tiles[depth_tile] = output_tiles[depth_tile] + product;
+        }
+        subgroupBarrier();
+    }
+
+    normalizer += subgroupShuffleXor(normalizer, 1);
+    normalizer += subgroupShuffleXor(normalizer, 2);
+    float final_scale = 1.0;
+    if (p.k_num == 1) {
+        if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
+            const float sink = float(perElemOpGetSink(local_row, 0, ACC_TYPE(0), iq2));
+            const float maximum = max(running_maximum, sink);
+            final_scale = exp(running_maximum - maximum);
+            normalizer = normalizer * final_scale + exp(sink - maximum);
+        }
+        final_scale = normalizer == 0.0 ? 0.0 : final_scale / normalizer;
+    }
+    float_workspace[float_base + lane] = vec4(final_scale);
+    if (p.k_num > 1 && row_lane == 0 && first_query + local_row < N) {
+        const uint address = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3
+            + p.ne1 * 2 * (split_k_index + p.k_num * (first_query + local_row + p.ne2 * iq3));
+        data_o[address + iq2] = normalizer;
+        data_o[address + p.ne1 + iq2] = running_maximum;
+    }
+    subgroupBarrier();
+    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> normalization;
+    coopMatLoad(normalization, float_workspace, float_base, 4, gl_CooperativeMatrixLayoutRowMajor);
+    subgroupBarrier();
+    [[unroll]] for (uint depth_tile = 0; depth_tile < 4; ++depth_tile) {
+        output_tiles[depth_tile] = output_tiles[depth_tile] * normalization;
+        coopMatStore(output_tiles[depth_tile], float_workspace, float_base + depth_tile * 4,
+                     16, gl_CooperativeMatrixLayoutRowMajor);
+    }
+    subgroupBarrier();
+    [[unroll]] for (uint index = lane; index < 128; index += 32) {
+        const uint row = first_query + index / 16;
+        if (row < N) {
+            const uint depth = index % 16;
+            const uint address = p.k_num > 1
+                ? HSV * p.ne1 * (split_k_index + p.k_num * (row + p.ne2 * iq3)) / 4 + iq2 * 16 + depth
+                : (iq3 * p.ne2 * p.ne1 * HSV + (row * p.ne1 + iq2) * HSV) / 4 + depth;
+            data_ov4[address] = float_workspace[float_base + index];
+        }
+    }
+}
