diff --git a/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp b/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
--- a/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
+++ b/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
@@ -58,15 +58,21 @@
 // Avoid padding for hsk==256 to make it fit in 48KB shmem.
 const uint32_t sfshstride = (HSK <= 128) ? (Br / 4 + 2) : Br / 4;
+const uint32_t osh_stride = row_split * MatBr / 4;
+#if defined(FA_O_F32)
+// Score reads finish before the existing Psh barrier; PV reads finish before
+// the existing end-of-KV-block barrier. Their F32 scratch lifetimes are disjoint.
+shared ACC_TYPEV4 scores_and_output[max(Bc * sfshstride, Br * osh_stride)];
+#define sfsh scores_and_output
+#define pvsh scores_and_output
+#else
 shared ACC_TYPEV4 sfsh[Bc * sfshstride];
+shared O_TYPEV4 pvsh[Br * osh_stride];
+#endif
 
 const uint32_t D_pad = HSK_pad > HSV_pad ? HSK_pad : HSV_pad;
 const uint32_t kvsh_stride = (SHMEM_STAGING != 0 ? D_pad : MatBr) / 4 + 2;
 const uint v_cols = MatBr / 4 * row_split; // total cols, 4 vec4s per MatBr * number of subgroups
 const uint vsh_stride = v_cols;
 shared FLOAT_TYPEV4 kvsh[(kvsh_stride >= vsh_stride) ? (Bc * kvsh_stride) : (Bc * vsh_stride)];
 
-const uint32_t osh_stride = row_split * MatBr / 4;
-// Br rows, because the PV accumulator's M spans Br and may need several tiles.
-shared O_TYPEV4 pvsh[Br * osh_stride];
-
 shared ACC_TYPE slope[Br];
