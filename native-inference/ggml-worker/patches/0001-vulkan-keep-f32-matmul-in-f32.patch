+    // Uta! Studio local patch: keep an all-F32 matrix multiply in F32.
+    //
+    // pipeline_matmul_f32 is built above from whichever shader family the
+    // device selected. In the coopmat2, coopmat and fp16 families the matmul
+    // shader's FLOAT_TYPE is float16_t (vulkan-shaders-gen.cpp promotes it
+    // whenever coopmat2 || fp16), so a multiply whose operands are both F32
+    // is still evaluated on F16-rounded operands. Measured against an exact
+    // f64 reference: 2.388e-3 worst relative error at k=9 and 1.596e-2 at
+    // k=1280, on both an AMD Radeon 780M and an Intel Arc B580, versus
+    // 2.391e-7 on the CPU backend.
+    //
+    // That is a reasonable trade for quantised LLM weights, which is what
+    // upstream tunes for -- test-backend-ops accordingly allows MUL_MAT an
+    // NMSE of 5e-4 where ordinary operations get 1e-7. Uta! Studio's audio
+    // graphs are F32 end to end and decode greedily, so the same trade turns
+    // into wrong output: FireRed transcribes its reference fixture correctly
+    // on the CPU lane and incorrectly on both GPUs.
+    //
+    // Rebuild only this one pipeline from the scalar _fp32 shaders, whose
+    // FLOAT_TYPE is float. Every F16, BF16 and quantised pipeline keeps the
+    // device's fast family, so this costs accuracy nowhere and speed only on
+    // F32 x F32. Measured cost on the B580: Leap separation 21.34s -> 23.58s,
+    // GAME medium 2.11s -> 2.24s.
+    //
+    // Only the coopmat and fp16 families were measured here; coopmat2 is
+    // covered by the same reasoning but was not available on this hardware.
+    if (!uta_promote_f32_matmul && (device->coopmat2 || device->coopmat_support || device->fp16)) {
+        const uint32_t f32_s_warptile_wm = device->subgroup_size == 8 ? 8 : 32;
+        const std::vector<uint32_t> f32_m_warptile = { 128,              64,  64, 16, subgroup_size_8,     32, 2, 4, 2, 1, subgroup_size_8 };
+        const std::vector<uint32_t> f32_s_warptile = { subgroup_size_32, 32,  32, 16, f32_s_warptile_wm,   32, 2, 2, 2, 1, subgroup_size_8 };
+
+        // The large scalar tile is the one upstream turns off for AMD and Intel
+        // whenever coopmat is unavailable, and measurement agrees: keeping it
+        // made Leap separation 71.3s against 23.1s on the medium and small
+        // tiles. Drop it for F32 the same way the scalar branch would, and
+        // clear the flag so the size heuristic never selects a pipeline that
+        // no longer exists.
+        device->mul_mat_l[GGML_TYPE_F32] = false;
+        if (device->mul_mat_m[GGML_TYPE_F32]) {
+            ggml_vk_create_pipeline(device, device->pipeline_matmul_f32->m, "matmul_f32_f32_m", matmul_f32_f32_fp32_len, matmul_f32_f32_fp32_data, "main", 3, sizeof(vk_mat_mat_push_constants), m_wg_denoms, ggml_vk_mul_mm_spec(f32_m_warptile, false), 1);
+            ggml_vk_create_pipeline(device, device->pipeline_matmul_f32->a_m, "matmul_f32_f32_aligned_m", matmul_f32_f32_fp32_len, matmul_f32_f32_fp32_data, "main", 3, sizeof(vk_mat_mat_push_constants), m_wg_denoms, ggml_vk_mul_mm_spec(f32_m_warptile, true), m_align);
+        }
+        if (device->mul_mat_s[GGML_TYPE_F32]) {
+            ggml_vk_create_pipeline(device, device->pipeline_matmul_f32->s, "matmul_f32_f32_s", matmul_f32_f32_fp32_len, matmul_f32_f32_fp32_data, "main", 3, sizeof(vk_mat_mat_push_constants), s_wg_denoms, ggml_vk_mul_mm_spec(f32_s_warptile, false), 1);
+            ggml_vk_create_pipeline(device, device->pipeline_matmul_f32->a_s, "matmul_f32_f32_aligned_s", matmul_f32_f32_fp32_len, matmul_f32_f32_fp32_data, "main", 3, sizeof(vk_mat_mat_push_constants), s_wg_denoms, ggml_vk_mul_mm_spec(f32_s_warptile, true), s_align);
+        }
